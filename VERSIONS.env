# =============================================================================
# Tool versions — the single place to change them
# =============================================================================
# Read by .github/actions/setup-tools (every workflow) and
# .devcontainer/post-create.sh. Plain KEY=VALUE lines only: no quotes, no
# spaces, no `export`, so bash, GitHub Actions and PowerShell can all read it.
#
# Not here, because they cannot read a file:
#   - `uses: owner/action@ref` lines in workflows (Dependabot bumps those);
#   - the devcontainer base image tag (.devcontainer/devcontainer.json,
#     python:<PYTHON_VERSION>) — post-create.sh warns when it drifts.
# Version constraints (not pins) stay with what they constrain:
#   deploy/terraform/versions.tf `required_version`, config/integrations/*.yaml.
# =============================================================================

# strata CLI — installed from the git tag v<STRATA_VERSION> (xyz-strata).
STRATA_VERSION=2.7.0

# Python for strata (>= 3.12) and ansible-core 2.22 (>= 3.13).
PYTHON_VERSION=3.13

# Terraform CLI for deploy/terraform (required_version >= 1.6).
TERRAFORM_VERSION=1.17.2

# Helm CLI — strata 2.7.0 uses Helm 4 flags (Helm 3 must be declared on a helm
# integration, and is deprecated).
HELM_VERSION=4.3.2

# ansible-core for deploy/ansible-hearth and deploy/ansible-forge.
ANSIBLE_CORE_VERSION=2.22.0
