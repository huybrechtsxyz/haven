{
  // Only strata's own documents: Ansible playbooks, Compose files and Helm
  // values are other YAML and must not be checked against the strata schema.
  "yaml.schemas": {
    ".strata/schemas/strata.json": [
      "strata.yaml",
      "config/**/*.yaml",
      "config/**/*.yml"
    ]
  },
  // Helm chart templates are Go-template text, not YAML: keep the YAML
  // extension (schema + formatter) away from them.
  "files.associations": {
    "**/templates/**/*.yaml": "plaintext",
    "**/templates/**/*.yml": "plaintext",
    "**/templates/**/*.tpl": "plaintext"
  },
  // Belt-and-braces: the association above did not always stick, and the YAML
  // formatter repeatedly rewrote "{{ }}" into "{ { } }" in Helm templates
  // (2026-09-28). Formatting off; validation and schema features stay on.
  "yaml.format.enable": false
}
