{
  "name": "haven",
  // Python tag must match PYTHON_VERSION in VERSIONS.env (post-create.sh warns).
  // strata, ansible-core, Terraform and Helm are installed by post-create.sh
  // at the versions in VERSIONS.env, not as features.
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "none",
      "minikube": "none"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "hashicorp.terraform",
        "ms-azure-devops.azure-pipelines",
        "ms-vscode-remote.remote-containers",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "vscode-icons-team.vscode-icons"
      ],
      "settings": {
        "[yaml]": {
          "editor.insertSpaces": true,
          "editor.tabSize": 2,
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.formatOnSave": true
        },
        "[terraform]": {
          "editor.formatOnSave": true
        },
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "remoteEnv": {
    "STRATA_WORK_PATH": "${containerWorkspaceFolder}"
  }
}