# =============================================================================
# Authentik Blueprint — Haven SSO Applications
# =============================================================================
# Generated by Ansible (hearth-config.yml) and applied automatically by the
# Authentik worker on startup from /blueprints/custom/.
#
# Client secrets are injected from Ansible vars, passed via --extra-vars at
# deploy time. Blueprints are idempotent — re-running updates existing
# resources in place.
#
# Known gap: Portainer has no OIDC provider/application block here yet — it
# still uses local username/password auth. See docs/guides/hearth.md's
# "Known gaps" table.
# =============================================================================

version: 1
metadata:
  name: haven-apps
entries:

  # ---------------------------------------------------------------------------
  # MFA — require MFA for all users; behavior for users without MFA is configurable
  # ---------------------------------------------------------------------------

  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    state: present
    identifiers:
      name: default-authentication-mfa-validation
    attrs:
      not_configured_action: "{{ authentik_mfa_not_configured_action }}"
{% if authentik_mfa_not_configured_action == "configure" %}
      configuration_stages:
        - !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, default-authenticator-totp-setup]]
{% endif %}

  - model: authentik_flows.flowstagebinding
    state: present
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, default-authentication-mfa-validation]]
    attrs:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, default-authentication-mfa-validation]]
      order: 30

  # ---------------------------------------------------------------------------
  # Groups
  # ---------------------------------------------------------------------------

  - model: authentik_core.group
    state: present
    identifiers:
      name: admins
    attrs:
      name: admins
      attributes:
        description: Technical administrators — full access to all applications

  - model: authentik_core.group
    state: present
    identifiers:
      name: parents
    attrs:
      name: parents
      attributes:
        description: Parents — access to all family applications

  - model: authentik_core.group
    state: present
    identifiers:
      name: members
    attrs:
      name: members
      attributes:
        description: Family members — access to shared applications

  # ---------------------------------------------------------------------------
  # Group access policies
  # ---------------------------------------------------------------------------

  - model: authentik_policies_expression.expressionpolicy
    state: present
    identifiers:
      name: policy-group-admins
    id: policy-group-admins
    attrs:
      name: policy-group-admins
      description: Grants access to admins group members only
      expression: "return ak_is_group_member(request.user, name='admins')"

  - model: authentik_policies_expression.expressionpolicy
    state: present
    identifiers:
      name: policy-group-parents
    id: policy-group-parents
    attrs:
      name: policy-group-parents
      description: Grants access to parents and admins group members
      expression: "return ak_is_group_member(request.user, name='parents') or ak_is_group_member(request.user, name='admins')"

  - model: authentik_policies_expression.expressionpolicy
    state: present
    identifiers:
      name: policy-group-members
    id: policy-group-members
    attrs:
      name: policy-group-members
      description: Grants access to all family members (members, parents, and admins)
      expression: "return ak_is_group_member(request.user, name='members') or ak_is_group_member(request.user, name='parents') or ak_is_group_member(request.user, name='admins')"

  # ---------------------------------------------------------------------------
  # Custom scope mapping — force email_verified: true for internal trusted users
  # ---------------------------------------------------------------------------
  # Authentik does not mark emails as verified for manually created accounts.
  # Vaultwarden rejects logins where email_verified is false. Since all users
  # on this server are trusted family members, we assert verified unconditionally.

  - model: authentik_providers_oauth2.scopemapping
    state: present
    identifiers:
      name: haven-email-verified
    id: mapping-email-verified
    attrs:
      name: haven-email-verified
      scope_name: openid
      description: Forces email_verified=true for trusted internal users
      expression: "return {'email_verified': True}"

  # ---------------------------------------------------------------------------
  # Vaultwarden — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Vaultwarden
    id: provider-vaultwarden
    attrs:
      name: Vaultwarden
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: vaultwarden
      client_secret: "{{ vaultwarden_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://vault.huybrechts.xyz/identity/connect/oidc-signin"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-email-verified
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      access_code_validity: minutes=1
      access_token_validity: hours=1
      refresh_token_validity: days=30

  - model: authentik_core.application
    state: present
    identifiers:
      slug: vaultwarden
    attrs:
      name: Vaultwarden
      slug: vaultwarden
      provider: !KeyOf provider-vaultwarden
      meta_launch_url: https://vault.huybrechts.xyz

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, vaultwarden]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, vaultwarden]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # WUD (What's Up Docker) — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: WUD
    id: provider-wud
    attrs:
      name: WUD
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: wud
      client_secret: "{{ wud_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://wud.huybrechts.xyz/auth/oidc/authentik/cb"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      issuer_mode: global

  - model: authentik_core.application
    state: present
    identifiers:
      slug: wud
    attrs:
      name: WUD
      slug: wud
      provider: !KeyOf provider-wud
      meta_launch_url: https://wud.huybrechts.xyz

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, wud]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, wud]]
      policy: !KeyOf policy-group-admins
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Jellyfin — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), not Hearth — the provider/application still lives in
  # this blueprint because Authentik itself (the IdP) runs on Hearth. The
  # matching client-side config (K0lin/jellyfin-plugin-sso) is registered
  # separately via that plugin's REST API — see config/forge/modules/jellyfin.yaml.

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Jellyfin
    id: provider-jellyfin
    attrs:
      name: Jellyfin
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: jellyfin
      client_secret: "{{ jellyfin_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://jellyfin.huybrechts.xyz/sso/OID/redirect/authentik"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      issuer_mode: global

  - model: authentik_core.application
    state: present
    identifiers:
      slug: jellyfin
    attrs:
      name: Jellyfin
      slug: jellyfin
      provider: !KeyOf provider-jellyfin
      meta_launch_url: https://jellyfin.huybrechts.xyz

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, jellyfin]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, jellyfin]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Nextcloud — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), not Hearth — same reasoning as Jellyfin's block above.
  # RBAC comes from the "groups" claim (this provider's scope mappings already
  # include the openid/email/profile scopes needed) — Nextcloud's user_oidc
  # app maps Authentik groups to Nextcloud groups automatically via its own
  # --group-provisioning=1 setting (see config/forge/modules/nextcloud.yaml).

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Nextcloud
    id: provider-nextcloud
    attrs:
      name: Nextcloud
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: nextcloud
      client_secret: "{{ nextcloud_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://drive.huybrechts.xyz/apps/user_oidc/code"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-email-verified
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      issuer_mode: global

  - model: authentik_core.application
    state: present
    identifiers:
      slug: nextcloud
    attrs:
      name: Nextcloud
      slug: nextcloud
      provider: !KeyOf provider-nextcloud
      meta_launch_url: https://drive.huybrechts.xyz

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, nextcloud]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, nextcloud]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Branding
  # ---------------------------------------------------------------------------

  - model: authentik_brands.brand
    state: present
    identifiers:
      domain: auth.huybrechts.xyz
    attrs:
      domain: auth.huybrechts.xyz
      branding_title: Haven
      default: true
