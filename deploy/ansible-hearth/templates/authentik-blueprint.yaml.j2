    identifiers:
      target: !Find [authentik_core.application, [slug, gatus]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, gatus]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Homarr — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), in the `system` namespace — same cross-Forge pattern
  # as Gatus. Family-facing dashboard/landing page linking to every deployed
  # service. Unlike every other app in this blueprint, Homarr does its OWN
  # RBAC sync from the "groups" claim: per Homarr's own docs, a user is
  # auto-placed into any locally-created Homarr group that shares the same
  # NAME as an Authentik group in this claim. Since this blueprint already
  # defines `admins`/`parents`/`members` groups, creating three matching
  # groups in Homarr's own admin UI (one-time manual step, no blueprint
  # equivalent for Homarr itself) is enough to get per-role board/permission
  # differences — e.g. an admin-only board with the bootstrap/infra links
  # further up this file, alongside the shared family board.
  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Homarr
    id: provider-homarr
    attrs:
      name: Homarr
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: homarr
      client_secret: "{{ homarr_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          # Homarr is built on Auth.js/NextAuth — fixed callback path for
          # any OIDC-shaped provider, confirmed via Homarr's own docs'
          # worked Authentik example (not app-specific/configurable).
          url: "https://home.huybrechts.xyz/api/auth/callback/oidc"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-email-verified
        - !KeyOf mapping-group-membership
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      # per_provider, not global — same issuer-mismatch reasoning as
      # Jellyfin/Nextcloud/Kavita above (see config/forge/modules/immich.yaml's
      # comment for the original root-cause writeup). Homarr's own docs
      # explicitly call out Authentik as the one provider where the issuer
      # URL needs its trailing slash kept — matches this per_provider format
      # exactly (config/forge/modules/homarr.yaml's AUTH_OIDC_ISSUER).
      issuer_mode: per_provider

  - model: authentik_core.application
    state: present
    identifiers:
      slug: homarr
    attrs:
      name: Homarr
      slug: homarr
      provider: !KeyOf provider-homarr
      meta_launch_url: https://home.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/homarr.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, homarr]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, homarr]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

