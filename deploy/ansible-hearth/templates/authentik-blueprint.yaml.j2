  # ---------------------------------------------------------------------------
  # Gatus (health/status dashboard) — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), in the `system` namespace — same cross-Forge pattern
  # as Jellyfin/Nextcloud/Kavita/Immich, the provider/application still lives
  # in this blueprint because Authentik itself (the IdP) runs on Hearth.
  # Members-only by design (no public access) — Gatus has native OIDC support
  # (security.oidc in its own config.yaml), so this is a real OAuth2 login
  # flow, not a forward-auth proxy setup.

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Gatus
    id: provider-gatus
    attrs:
      name: Gatus
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: gatus
      client_secret: "{{ gatus_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          # Gatus's own OIDC doc requires the redirect URL to end with this
          # exact path — not app-specific/configurable elsewhere.
          url: "https://status.huybrechts.xyz/authorization-code/callback"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      access_code_validity: minutes=1
      access_token_validity: hours=1
      refresh_token_validity: days=30

  - model: authentik_core.application
    state: present
    identifiers:
      slug: gatus
    attrs:
      name: Gatus
      slug: gatus
      provider: !KeyOf provider-gatus
      meta_launch_url: https://status.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/gatus.png

  - model: authentik_policies.policybinding
