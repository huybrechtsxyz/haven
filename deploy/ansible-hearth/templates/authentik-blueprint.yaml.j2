# =============================================================================
# Authentik Blueprint — Haven SSO Applications
# =============================================================================
# Generated by Ansible (hearth-config.yml) and applied automatically by the
# Authentik worker on startup from /blueprints/custom/.
#
# Client secrets are injected from Ansible vars, passed via --extra-vars at
# deploy time. Blueprints are idempotent — re-running updates existing
# resources in place.
#
# Portainer already exists manually in the Authentik dashboard as a
# dashboard-only application (currently without an icon), so there is no need
# to add an ACTIVE managed block here right now.
#
# If Portainer is later made declarative for dashboard visibility only, the
# managed block would look like this:
#
# - model: authentik_core.application
#   state: present
#   identifiers:
#     slug: portainer
#   attrs:
#     name: Portainer
#     slug: portainer
#     meta_launch_url: https://portainer.huybrechts.xyz
#     meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/portainer.png
#
# - model: authentik_policies.policybinding
#   state: present
#   identifiers:
#     target: !Find [authentik_core.application, [slug, portainer]]
#     order: 0
#   attrs:
#     target: !Find [authentik_core.application, [slug, portainer]]
#     policy: !KeyOf policy-group-admins
#     order: 0
#     enabled: true
#     negate: false
#     timeout: 30
# =============================================================================

version: 1
metadata:
  name: haven-apps
entries:

  # ---------------------------------------------------------------------------
  # MFA — require MFA for all users; behavior for users without MFA is configurable
  # ---------------------------------------------------------------------------

  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    state: present
    identifiers:
      name: default-authentication-mfa-validation
    attrs:
      not_configured_action: "{{ authentik_mfa_not_configured_action }}"
      # Explicit device_classes so WebAuthn (passkeys/security keys) is
      # accepted as a valid MFA method during login, not just TOTP/static
      # backup codes — omitting this would silently restrict validation to
      # whatever Authentik's own model default is.
      device_classes:
        - static
        - totp
        - webauthn
{% if authentik_mfa_not_configured_action == "configure" %}
      configuration_stages:
        - !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, default-authenticator-totp-setup]]
        # Built-in stage Authentik ships with every install (same !Find
        # pattern as the TOTP setup stage above — not defined by this
        # blueprint, just referenced) — lets a user without any configured
        # MFA method choose to register a passkey/security key instead of
        # TOTP when prompted.
        - !Find [authentik_stages_authenticator_webauthn.authenticatorwebauthnstage, [name, default-authenticator-webauthn-setup]]
{% endif %}

  - model: authentik_flows.flowstagebinding
    state: present
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, default-authentication-mfa-validation]]
    attrs:
      target: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, default-authentication-mfa-validation]]
      order: 30

  # ---------------------------------------------------------------------------
  # Groups
  # ---------------------------------------------------------------------------

  - model: authentik_core.group
    state: present
    identifiers:
      name: admins
    attrs:
      name: admins
      attributes:
        description: Technical administrators — full access to all applications

  - model: authentik_core.group
    state: present
    identifiers:
      name: parents
    attrs:
      name: parents
      attributes:
        description: Parents — access to all family applications

  - model: authentik_core.group
    state: present
    identifiers:
      name: members
    attrs:
      name: members
      attributes:
        description: Family members — access to shared applications

  # ---------------------------------------------------------------------------
  # Group access policies
  # ---------------------------------------------------------------------------

  - model: authentik_policies_expression.expressionpolicy
    state: present
    identifiers:
      name: policy-group-admins
    id: policy-group-admins
    attrs:
      name: policy-group-admins
      description: Grants access to admins group members only
      expression: "return ak_is_group_member(request.user, name='admins')"

  - model: authentik_policies_expression.expressionpolicy
    state: present
    identifiers:
      name: policy-group-parents
    id: policy-group-parents
    attrs:
      name: policy-group-parents
      description: Grants access to parents and admins group members
      expression: "return ak_is_group_member(request.user, name='parents') or ak_is_group_member(request.user, name='admins')"

  - model: authentik_policies_expression.expressionpolicy
    state: present
    identifiers:
      name: policy-group-members
    id: policy-group-members
    attrs:
      name: policy-group-members
      description: Grants access to all family members (members, parents, and admins)
      expression: "return ak_is_group_member(request.user, name='members') or ak_is_group_member(request.user, name='parents') or ak_is_group_member(request.user, name='admins')"

  # ---------------------------------------------------------------------------
  # Custom scope mapping — force email_verified: true for internal trusted users
  # ---------------------------------------------------------------------------
  # Authentik does not mark emails as verified for manually created accounts.
  # Vaultwarden rejects logins where email_verified is false. Since all users
  # on this server are trusted family members, we assert verified unconditionally.

  - model: authentik_providers_oauth2.scopemapping
    state: present
    identifiers:
      name: haven-email-verified
    id: mapping-email-verified
    attrs:
      name: haven-email-verified
      scope_name: openid
      description: Forces email_verified=true for trusted internal users
      expression: "return {'email_verified': True}"

  # ---------------------------------------------------------------------------
  # Custom scope mapping — expose group membership for RBAC-capable OIDC clients
  # ---------------------------------------------------------------------------
  # Per K0lin/jellyfin-plugin-sso's own docs (providers.md#authentik), Authentik
  # doesn't include group membership in the standard OIDC scopes — a custom
  # "groups" scope + property mapping is required so the plugin can read
  # RoleClaim: groups and auto-assign admin/user access from group membership
  # (admins group -> AdminRoles, members/parents -> Roles) instead of a flat
  # enableAuthorization: false (which would grant every SSO login full access).

  - model: authentik_providers_oauth2.scopemapping
    state: present
    identifiers:
      name: haven-group-membership
    id: mapping-group-membership
    attrs:
      name: haven-group-membership
      scope_name: groups
      description: Exposes the user's Authentik group names for RBAC-capable OIDC clients (e.g. Jellyfin)
      expression: "return [group.name for group in user.ak_groups.all()]"

  # ---------------------------------------------------------------------------
  # Vaultwarden — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Vaultwarden
    id: provider-vaultwarden
    attrs:
      name: Vaultwarden
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: vaultwarden
      client_secret: "{{ vaultwarden_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://vault.huybrechts.xyz/identity/connect/oidc-signin"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-email-verified
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      access_code_validity: minutes=1
      access_token_validity: hours=1
      refresh_token_validity: days=30

  - model: authentik_core.application
    state: present
    identifiers:
      slug: vaultwarden
    attrs:
      name: Vaultwarden
      slug: vaultwarden
      provider: !KeyOf provider-vaultwarden
      meta_launch_url: https://vault.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/vaultwarden.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, vaultwarden]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, vaultwarden]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # WUD (What's Up Docker) — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: WUD
    id: provider-wud
    attrs:
      name: WUD
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: wud
      client_secret: "{{ wud_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://wud.huybrechts.xyz/auth/oidc/authentik/cb"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      # DELIBERATELY left as global, unlike Jellyfin/Nextcloud/Immich — WUD is
      # CONFIRMED WORKING in production with this setting as-is. Don't change
      # without testing: WUD's SSO login flow already works end-to-end, so
      # whatever OIDC client library whats-up-docker uses evidently isn't
      # doing the strict issuer-vs-discovery-path validation that broke
      # Jellyfin/Immich under per_provider's absence. Flipping this without a
      # live re-test risks breaking something that already works.
      issuer_mode: global

  - model: authentik_core.application
    state: present
    identifiers:
      slug: wud
    attrs:
      name: WUD
      slug: wud
      provider: !KeyOf provider-wud
      meta_launch_url: https://wud.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/whats-up-docker.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, wud]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, wud]]
      policy: !KeyOf policy-group-admins
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Jellyfin — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), not Hearth — the provider/application still lives in
  # this blueprint because Authentik itself (the IdP) runs on Hearth. The
  # matching client-side config (K0lin/jellyfin-plugin-sso) is registered
  # separately via that plugin's REST API — see config/forge/modules/jellyfin.yaml.

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Jellyfin
    id: provider-jellyfin
    attrs:
      name: Jellyfin
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: jellyfin
      client_secret: "{{ jellyfin_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://media.huybrechts.xyz/sso/OID/redirect/authentik"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-group-membership
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      # per_provider, not global — global mode's issuer claim is just the bare
      # domain (https://auth.huybrechts.xyz/), which doesn't match the
      # app-specific discovery path (.../application/o/jellyfin/) and breaks
      # strict OIDC issuer validation. Hit + fixed for real on Immich first
      # (see config/forge/modules/immich.yaml's comment) — applying the same
      # fix here proactively before Jellyfin's SSO is tested for the first time.
      issuer_mode: per_provider

  - model: authentik_core.application
    state: present
    identifiers:
      slug: jellyfin
    attrs:
      name: Jellyfin
      slug: jellyfin
      provider: !KeyOf provider-jellyfin
      meta_launch_url: https://media.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/jellyfin.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, jellyfin]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, jellyfin]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Nextcloud — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), not Hearth — same reasoning as Jellyfin's block above.
  # RBAC comes from the "groups" claim (mapping-group-membership, same custom
  # scope mapping used by Jellyfin — attached to property_mappings below) —
  # Nextcloud's user_oidc app maps Authentik groups to Nextcloud groups
  # automatically via its own --group-provisioning=1 setting (see
  # config/forge/modules/nextcloud.yaml).

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Nextcloud
    id: provider-nextcloud
    attrs:
      name: Nextcloud
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: nextcloud
      client_secret: "{{ nextcloud_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://docs.huybrechts.xyz/apps/user_oidc/code"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-email-verified
        - !KeyOf mapping-group-membership
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      # per_provider, not global — same issuer-mismatch reasoning as Jellyfin's
      # block above (see config/forge/modules/immich.yaml's comment for the
      # original root-cause writeup). Fixed proactively before Nextcloud's SSO
      # is tested for the first time.
      issuer_mode: per_provider

  - model: authentik_core.application
    state: present
    identifiers:
      slug: nextcloud
    attrs:
      name: Nextcloud
      slug: nextcloud
      provider: !KeyOf provider-nextcloud
      meta_launch_url: https://docs.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/nextcloud.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, nextcloud]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, nextcloud]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Kavita — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), not Hearth — same reasoning as Jellyfin/Nextcloud
  # above. Kavita has NATIVE OIDC support (Kavita.Common.Configuration's
  # OpenIdConnectSettings — Authority/ClientId/Secret/CustomScopes), read
  # from config/appsettings.json on the pod's config PVC at process startup
  # (no admin UI toggle, no plugin, no REST API). deploy-forge-deploy.yml
  # writes that settings block after every Helm deploy and restarts the pod
  # if it changed, so — unlike Jellyfin (needs a UI-minted API key first) —
  # this is fully automated with zero manual steps once
  # KAVITA_SSO_CLIENT_SECRET exists in Infisical.
  #
  # redirect_uris uses https:// — CONFIRMED LIVE (2026-08-29) via an actual
  # failed authorize request: Kavita's own ASP.NET Core OIDC handler sends
  # redirect_uri=https://books.huybrechts.xyz/signin-oidc even though Traefik
  # terminates TLS and forwards plain HTTP to the pod. So — unlike Jellyfin's
  # plugin, which needed an explicit schemeOverride to force https — Kavita's
  # forwarded-headers scheme detection is evidently already trusting Traefik
  # here (exact mechanism not fully diagnosed — possibly a k3s-specific
  # network path — but the live behavior is what matters). This was
  # initially registered as http:// (before Kavita's ingress had TLS) and
  # broke the very first login attempt with Authentik's "Redirect URI Error"
  # once TLS went live — fixed here to match reality.

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Kavita
    id: provider-kavita
    attrs:
      name: Kavita
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: kavita
      client_secret: "{{ kavita_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://books.huybrechts.xyz/signin-oidc"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-email-verified
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      # per_provider, not global — same issuer-mismatch reasoning as
      # Jellyfin/Nextcloud above (see config/forge/modules/immich.yaml's
      # comment for the original root-cause writeup). Fixed proactively
      # before Kavita's SSO is tested for the first time.
      issuer_mode: per_provider

  - model: authentik_core.application
    state: present
    identifiers:
      slug: kavita
    attrs:
      name: Kavita
      slug: kavita
      provider: !KeyOf provider-kavita
      meta_launch_url: https://books.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/kavita.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, kavita]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, kavita]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Immich — OAuth2/OIDC Provider + Application
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), not Hearth — same reasoning as Jellyfin/Nextcloud
  # above. Unlike Jellyfin (needs a separate plugin registration) or
  # Nextcloud (needs its own user_oidc app config), Immich has NATIVE OIDC
  # support configured entirely through its own Admin Settings UI (System
  # Settings > OAuth) — no client-side plugin/app config needed beyond that
  # one-time toggle, using this same client_id/client_secret/issuer.

  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: Immich
    id: provider-immich
    attrs:
      name: Immich
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: immich
      client_secret: "{{ immich_sso_client_secret }}"
      redirect_uris:
        - matching_mode: strict
          url: "https://photos.huybrechts.xyz/auth/login"
        - matching_mode: strict
          url: "https://photos.huybrechts.xyz/user-settings"
        - matching_mode: strict
          url: "app.immich:///oauth-callback"
      grant_types:
        - authorization_code
        - refresh_token
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
      sub_mode: hashed_user_id
      # per_provider (not global, unlike WUD/Jellyfin/Nextcloud above) — Immich
      # does strict OIDC issuer validation (the discovery doc's "issuer" claim
      # must exactly match the configured Issuer URL). In "global" mode
      # Authentik's issuer is just the bare domain (https://auth.huybrechts.xyz/),
      # which doesn't match the app-specific discovery path Immich fetches it
      # from (.../application/o/immich/.well-known/openid-configuration) —
      # confirmed via a real "discovered metadata issuer does not match
      # expected issuer" error. per_provider makes the issuer itself
      # app-specific (https://auth.huybrechts.xyz/application/o/immich/),
      # self-consistent with the discovery path — same mode Vaultwarden
      # already uses successfully.
      issuer_mode: per_provider

  - model: authentik_core.application
    state: present
    identifiers:
      slug: immich
    attrs:
      name: Immich
      slug: immich
      provider: !KeyOf provider-immich
      meta_launch_url: https://photos.huybrechts.xyz
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/immich.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, immich]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, immich]]
      policy: !KeyOf policy-group-members
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # ---------------------------------------------------------------------------
  # Firefly III — Proxy Provider (forward auth, single application)
  # ---------------------------------------------------------------------------
  # Runs on Forge (k3s), not Hearth — same reasoning as Jellyfin/Nextcloud/
  # Kavita/Immich above. UNLIKE every app above, Firefly III has NO native
  # OIDC support (confirmed from its own docs — only 'web' built-in DB auth
  # or 'remote_user_guard', a header-based mode for reverse-proxy-terminated
  # auth). So this uses an `authentik_providers_proxy.proxyprovider` in
  # "forward auth (single application)" mode instead of an OAuth2 provider —
  # the first use of this provider type in this blueprint.
  #
  # No client_secret needed here (unlike every oauth2provider above) — forward
  # auth has no app-side OAuth client at all; Traefik's forwardAuth middleware
  # (services/forge/firefly/templates/middleware.yaml) talks to the outpost
  # directly, and Firefly only ever sees the already-authenticated request
  # plus the injected X-authentik-* headers.
  #
  # external_host MUST be the app's own domain (not auth.huybrechts.xyz) —
  # this is what Authentik's docs specify for single-application forward
  # auth mode, and is why Traefik needs the cross-host outpost-bypass
  # routing documented in firefly's own chart (see
  # services/forge/firefly/templates/ingress-outpost.yaml).
  #
  # Not explicitly assigned to an outpost here — see the dedicated
  # `authentik_outposts.outpost` block further down this file (search
  # "Explicit outpost assignment") for the required `providers:` M2M
  # assignment. Proxy providers are NEVER auto-managed by the embedded
  # outpost — that assignment is mandatory, not automatic.

  - model: authentik_providers_proxy.proxyprovider
    state: present
    identifiers:
      name: Firefly III
    id: provider-firefly
    attrs:
      name: Firefly III
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      mode: forward_single
      external_host: https://finance.huybrechts.xyz
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, email]]
        - !Find [authentik_providers_oauth2.scopemapping, [scope_name, profile]]
        - !KeyOf mapping-email-verified

  - model: authentik_core.application
    state: present
    identifiers:
      slug: firefly
    attrs:
      name: Firefly III
      slug: firefly
      provider: !KeyOf provider-firefly
      meta_launch_url: https://finance.huybrechts.xyz
      # TODO: verify this icon filename actually exists in homarr-labs/dashboard-icons
      # before first deploy (unlike every other meta_icon above, this one
      # wasn't confirmed via a real fetch when this block was authored).
      meta_icon: https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/png/firefly.png

  - model: authentik_policies.policybinding
    state: present
    identifiers:
      target: !Find [authentik_core.application, [slug, firefly]]
      order: 0
    attrs:
      target: !Find [authentik_core.application, [slug, firefly]]
      # parents (+ admins), not members — financial data is more sensitive
      # than the shared-family apps above; change to policy-group-members
      # if kids should have their own accounts too.
      policy: !KeyOf policy-group-parents
      order: 0
      enabled: true
      negate: false
      timeout: 30

  # Explicit outpost assignment — REQUIRED, not automatic. Confirmed via
  # Authentik's own docs (embedded-outpost page): "Any hosts configured in
  # the providers ASSIGNED to the embedded outpost are sent to the outpost" —
  # assignment is opt-in per provider, never automatic for newly-created
  # Proxy/LDAP/RADIUS providers. The original comment above assumed the
  # embedded outpost auto-manages any unassigned provider — WRONG, confirmed
  # by a real live bug (2026-09-06): without this block, forwardAuth's calls
  # to https://finance.huybrechts.xyz/outpost.goauthentik.io/auth/traefik
  # never reached a real auth check (host not routed to any outpost), so
  # every request — including real browser traffic — fell through to
  # Firefly unauthenticated, producing "No user in header" 500s. Firefly is
  # the ONLY Proxy-type provider in this whole blueprint, so setting
  # providers to just this one list is safe (nothing else to lose from the
  # embedded outpost's provider set).
  #
  # CONFIRMED FIELD NAME (2026-09-07, from Authentik source
  # authentik/outposts/models.py): `Outpost.providers` is the actual M2M
  # field (`models.ManyToManyField(Provider, through="OutpostProvider")`),
  # NOT `protocol_providers` — that wrong name was silently ignored by
  # blueprint apply (no error, just a no-op), which is why the Outpost edit
  # UI kept showing Firefly under "Available" instead of "Selected" even
  # after this block was supposedly applied. Fixed to the real field name.
  - model: authentik_outposts.outpost
    state: present
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      providers:
        - !Find [authentik_providers_proxy.proxyprovider, [name, Firefly III]]

